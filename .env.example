LLM_BASE_URL=https://api.deepseek.com
# DeepSeek currently routes this API model ID to V4.1-Flash-1017.
LLM_MODEL=deepseek-flash
LLM_API_KEY=

# Docker Compose defaults: Ollama and Qdrant are private service endpoints
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
EMBEDDING_MODEL=nomic-embed-text:latest
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=agent_qa_knowledge

# Local Docker stack secrets (replace before sharing beyond a trusted LAN)
POSTGRES_DB=agentqa
POSTGRES_USER=agentqa
POSTGRES_PASSWORD=change-this-postgres-password
S3_BUCKET=agent-qa-uploads
S3_ACCESS_KEY=agentqa
S3_SECRET_KEY=change-this-object-storage-password
S3_ADMIN_PASSWORD=change-this-storage-admin-password
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-this-grafana-password
# Bind the web entrypoint to loopback; terminate HTTPS at a host reverse proxy.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=18080

# Backpressure and capacity controls
MODEL_CONCURRENCY=8
CHAT_WORKER_CONCURRENCY=16
DOCUMENT_WORKER_CONCURRENCY=2
CHAT_RATE_LIMIT_PER_MINUTE=30
MAX_CHAT_QUEUE=1000
PG_POOL_MAX=20

# Optional: use a remote OpenAI-compatible embedding service with Qdrant instead
# EMBEDDING_PROVIDER=openai-compatible
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=
# QDRANT_API_KEY=
